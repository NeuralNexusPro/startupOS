{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@originos/core/*": ["../../core/src/*"] },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts"]
}
