{
  "name": "@originos/desktop",
  "version": "0.1.48",
  "private": true,
  "main": "dist-electron/desktop/src/main/main.js",
  "scripts": {
    "test": "vitest run",
    "dev": "pnpm --filter @originos/pi-agent-adapter build && pnpm build && concurrently \"pnpm --filter @originos/web exec next dev -p 3100\" \"tsc -p tsconfig.json --watch\" \"wait-on tcp:3100 ../../dist-electron/desktop/src/main/main.js && electron ../../dist-electron/desktop/src/main/main.js --renderer-url=http://localhost:3100\"",
    "build": "tsc -p tsconfig.json",
    "build:app": "rm -rf ../web/.next ../../dist-electron && pnpm --filter @originos/pi-agent-adapter build && pnpm --filter @originos/web build && node scripts/prepare-web-standalone.js && node scripts/prepare-pi-ai-runtime-deps.js && pnpm build && node ../../scripts/check-root-build-artifacts.js && node scripts/verify-agent-worker-runtime.js && rm -rf dist-electron && mkdir -p dist-electron && cp -R ../../dist-electron/. dist-electron/ && node ../../scripts/check-root-build-artifacts.js",
    "pack": "pnpm build:app && electron-builder --config electron-builder.yml --dir",
    "dist": "pnpm build:app && electron-builder --config electron-builder.yml --publish never",
    "dist:win:local": "node scripts/build-windows-local.js",
    "dist:mac:arm64": "pnpm build:app && electron-builder --config electron-builder.yml --mac --arm64 --publish never",
    "dist:mac:x64": "pnpm build:app && electron-builder --config electron-builder.yml --mac --x64 --publish never",
    "dist:mac:app": "pnpm build:app && electron-builder --config electron-builder.yml --mac dir --arm64 --x64 --publish never",
    "dist:mac": "pnpm dist:mac:app && NODE_OPTIONS= node scripts/create-mac-dmg.js",
    "dist:mac:publish": "pnpm build:app && electron-builder --config electron-builder.yml --mac --arm64 --x64 --publish always",
    "verify:mac-package": "node scripts/verify-mac-package.js",
    "verify:pi-task-runtime": "node scripts/verify-pi-task-runtime-package.js --development",
    "test:pi-task-runtime-package": "vitest run scripts/__tests__/verify-pi-task-runtime-package.test.mjs",
    "verify:mac-signing": "node scripts/verify-mac-signing.js",
    "verify:workspace-upload": "node scripts/verify-workspace-upload-ipc.js",
    "bump-version": "node scripts/bump-release-version.js",
    "publish:qiniu": "node scripts/publish-qiniu-updates.js",
    "cleanup:qiniu": "node scripts/publish-qiniu-updates.js --retention-only",
    "release:qiniu": "node scripts/release-qiniu.js",
    "dist:qiniu": "pnpm release:qiniu",
    "dist:win": "ORIGINOS_WINDOWS_SHORT_ZIP=1 pnpm build:app && electron-builder --config electron-builder.yml --win --publish never",
    "dist:linux": "pnpm build:app && electron-builder --config electron-builder.yml --linux --publish never",
    "verify:win-package": "node scripts/verify-windows-package.js",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.js && node scripts/verify-update-metadata.js",
    "verify:update-metadata": "node scripts/verify-update-metadata.js",
    "generate:update-metadata": "node scripts/generate-update-metadata.js",
    "verify:asar-requires": "node scripts/verify-asar-relative-requires.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.51",
    "@originos/pi-agent-adapter": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "archiver": "^8.0.0",
    "dotenv": "^16.6.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.3",
    "ignore": "^7.0.5",
    "onnxruntime-node": "^1.26.0",
    "qiniu": "^7.14.0",
    "uuid": "^14.0.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.0.0",
    "adm-zip": "^0.6.0",
    "concurrently": "^9.2.1",
    "electron": "^42.3.2",
    "electron-builder": "^26.0.12",
    "tsx": "^4.22.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "wait-on": "^8.0.5"
  }
}
