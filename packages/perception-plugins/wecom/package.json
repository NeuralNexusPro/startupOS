{
  "name": "@originos/perception-plugin-wecom",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/perception-plugins/wecom/src/index.js",
  "types": "./dist/perception-plugins/wecom/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/perception-plugins/wecom/src/index.d.ts", "default": "./dist/perception-plugins/wecom/src/index.js" }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@originos/core": "workspace:*",
    "@wecom/cli": "1.2.1",
    "@wecom/aibot-node-sdk": "1.0.6"
  },
  "optionalDependencies": {
    "@wecom/cli-darwin-arm64": "1.2.1",
    "@wecom/cli-darwin-x64": "1.2.1",
    "@wecom/cli-linux-arm64": "1.2.1",
    "@wecom/cli-linux-x64": "1.2.1",
    "@wecom/cli-win32-x64": "1.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
